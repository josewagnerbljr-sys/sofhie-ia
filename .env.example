# Copie este arquivo para ".env" e preencha com suas chaves reais.
# NUNCA compartilhe o arquivo .env preenchido.

# Chave gratuita gerada em console.groq.com
GROQ_API_KEY=coloque_sua_chave_groq_aqui

# Chave gratuita gerada em aistudio.google.com/app/apikey (usada como fallback se a Groq atingir o limite diário)
GEMINI_API_KEY=coloque_sua_chave_gemini_aqui

# Limite de segurança: novos contatos iniciados pela IA por dia (anti-ban)
LIMITE_NOVOS_CONTATOS_DIA=30

# Limite de segurança: mensagens totais enviadas por dia (anti-ban)
LIMITE_MENSAGENS_DIA=200

# Porta local do dashboard HTML
DASHBOARD_PORT=5000

# Seu número pessoal de WhatsApp (formato internacional, ex: 5544999999999@s.whatsapp.net)
# usado para receber notificações automáticas de leads prontos para fechamento
NUMERO_NOTIFICACAO_DONO=5500000000000@s.whatsapp.net

# URL da ponte Node.js (whatsapp-service), usada pelo Python para enviar notificações
WHATSAPP_BRIDGE_URL=http://localhost:8001

# Instagram — API oficial (Meta for Developers > Graph API)
INSTAGRAM_ACCESS_TOKEN=coloque_seu_token_de_longa_duracao_aqui
INSTAGRAM_BUSINESS_ACCOUNT_ID=coloque_o_id_da_conta_business_aqui

# LinkedIn — API oficial (perfil pessoal, produto "Share on LinkedIn")
# Nao preencha estes dois na mao — rode: python -m src.gerar_token_linkedin
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
